# Backend origin for the Vite DEV proxy only (vite.config.ts). Local dev.
VITE_BACKEND_URL=http://backend.url

# Backend origin for the PROD reverse-proxy (middleware.ts on Vercel).
# Non-VITE_ prefix on purpose: keeps the host out of the client bundle.
# Set in Vercel → Project Settings → Environment Variables (Prod/Preview/Dev).
BACKEND_ORIGIN=http://backend.url

# Relative, same-origin. Dev: tunneled by Vite proxy (vite.config.ts).
# Prod (Vercel): /api/* reverse-proxied to BACKEND_ORIGIN via middleware.ts.
# Set the same value in Vercel → Project Settings → Environment Variables.
VITE_API_BASE_URL=/api/v1

# Optional override; defaults to package.json version via vite.config.ts.
VITE_APP_VERSION=0.1.0

# WebSocket (socket.io) URL. Defaults to same-origin /ws (works with Vite proxy).
# Set explicitly for production or when backend is on a different host.
# VITE_WS_URL=wss://backend.url/ws
